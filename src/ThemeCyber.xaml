<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:HallowGuard;assembly=HallowGuard">
    <!-- v1.4 "Cyber" look, v1.7 "Cyber blue" (optional): the security console in neon cyan. Merged over Theme.xaml (same keys
         win), only when Settings > Look is Cyber blue. Never gets the Hallow accent swapped in.
         Near-black blue, thin cyan lines, electric green = secure, amber = warning, magenta-red = threat. Focus = a neon outline. -->
    <h:IconConv x:Key="IconConv"/><h:IconVis x:Key="IconVis"/><h:LabelVis x:Key="LabelVis"/><h:IconGap x:Key="IconGap"/>
    <SolidColorBrush x:Key="Bg" Color="#070B12"/>
    <SolidColorBrush x:Key="Panel" Color="#0B1320"/>
    <SolidColorBrush x:Key="PanelHi" Color="#102033"/>
    <SolidColorBrush x:Key="Line" Color="#1A3550"/>
    <SolidColorBrush x:Key="Text" Color="#DDF6FF"/>
    <SolidColorBrush x:Key="Muted" Color="#8AA6BA"/>
    <SolidColorBrush x:Key="CheckedBg" Color="#0F3A48"/>
    <SolidColorBrush x:Key="CheckedLine" Color="#22E1FF"/>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- keyboard focus: a neon outline -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#22E1FF" StrokeThickness="1.5" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True">
                        <Rectangle.Effect><DropShadowEffect Color="#22E1FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeonFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#22E1FF" StrokeThickness="1.5" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True">
                        <Rectangle.Effect><DropShadowEffect Color="#22E1FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: squared, thin border, glow on hover -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="#CDEFFF"/>
        <Setter Property="Background" Value="#0C1826"/>
        <Setter Property="BorderBrush" Value="#21425E"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"/>
                        <Border x:Name="hl" Background="#22E1FF" Opacity="0" CornerRadius="2"/>
                        <StackPanel x:Name="sp" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ic" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconConv}}"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconVis}}"
                                  Margin="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGap}}"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.08"/><Setter TargetName="b" Property="BorderBrush" Value="#22E1FF"/>
                            <Setter TargetName="b" Property="Effect"><Setter.Value><DropShadowEffect Color="#22E1FF" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.16"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        <Trigger Property="Tag" Value="icon"><Setter TargetName="cp" Property="Visibility" Value="Collapsed"/><Setter TargetName="ic" Property="Margin" Value="0"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CheckedBg}"/><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CheckedLine}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Btn}"/>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0F4253" Offset="0"/><GradientStop Color="#0A2C3A" Offset="1"/></LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#22E1FF"/>
        <Setter Property="Foreground" Value="#7FF0FF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#DDF6FF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="track" DockPanel.Dock="Left" Width="40" Height="20" CornerRadius="2" Background="#0C1826" BorderBrush="#2A4A66" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="word" Text="OFF" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#8AA6BA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border x:Name="knob" Width="12" Height="12" CornerRadius="1" Background="#5C7A92" HorizontalAlignment="Left" Margin="3,0,3,0"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#39FF88"/>
                            <Setter TargetName="track" Property="Background" Value="#0E2E22"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Background" Value="#39FF88"/>
                            <Setter TargetName="word" Property="Text" Value="ON"/>
                            <Setter TargetName="word" Property="Foreground" Value="#39FF88"/>
                            <Setter TargetName="word" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="word" Property="Margin" Value="5,0,0,0"/>
                            <Setter TargetName="knob" Property="Effect"><Setter.Value><DropShadowEffect Color="#39FF88" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#22E1FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="#DDF6FF"/>
        <Setter Property="CaretBrush" Value="#22E1FF"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="#060C14" BorderBrush="#1A3550" BorderThickness="1" CornerRadius="2" Padding="10,0" Height="32">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#22E1FF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PasswordField" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="#DDF6FF"/>
        <Setter Property="CaretBrush" Value="#22E1FF"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="#060C14" BorderBrush="#1A3550" BorderThickness="1" CornerRadius="2" Padding="10,0" Height="32">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#22E1FF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="#DDF6FF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#0B1320" BorderBrush="#1F4561" BorderThickness="1" CornerRadius="2" Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#DDF6FF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#0B1320" BorderBrush="#22E1FF" BorderThickness="1" CornerRadius="2" Padding="10,6"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="1" Background="#1A3550" Margin="3,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#22789A"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="#22E1FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the page list: a neon bar on the left of the open page, the icon glows on hover -->
    <Style x:Key="Nav" TargetType="Button">
        <Setter Property="Foreground" Value="#B9D6E8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="0,1">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="#22E1FF" Visibility="Hidden">
                            <Rectangle.Effect><DropShadowEffect Color="#22E1FF" BlurRadius="10" ShadowDepth="0" Opacity="1"/></Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0D1A28"/>
                            <Setter TargetName="cp" Property="Effect"><Setter.Value><DropShadowEffect Color="#22E1FF" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3322E1FF" Offset="0"/><GradientStop Color="#0022E1FF" Offset="1"/></LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#22E1FF"/>
        <Setter Property="Background" Value="#0C1826"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
    </Style>
</ResourceDictionary>
