<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:HallowGuard;assembly=HallowGuard">
    <!-- v1.7 "Hallow console" look (the default): the 1.4 security-console HUD repainted in the Hallow palette. Merged over
         Theme.xaml (same keys win). The family's dark purple-black, the Hallow accent as the glow (swapped for the theme.json
         accent like Theme.xaml, also in #AARRGGBB forms), lilac secondaries, the family green. Focus = an outline in the accent. -->
    <h:IconConv x:Key="IconConv"/><h:IconVis x:Key="IconVis"/><h:LabelVis x:Key="LabelVis"/><h:IconGap x:Key="IconGap"/>
    <SolidColorBrush x:Key="Bg" Color="#14101B"/>
    <SolidColorBrush x:Key="Panel" Color="#1C1726"/>
    <SolidColorBrush x:Key="PanelHi" Color="#221C2E"/>
    <SolidColorBrush x:Key="Line" Color="#3A3248"/>
    <SolidColorBrush x:Key="Text" Color="#ECE8F4"/>
    <SolidColorBrush x:Key="Muted" Color="#9790A8"/>
    <SolidColorBrush x:Key="CheckedBg" Color="#40F07820"/>
    <SolidColorBrush x:Key="CheckedLine" Color="#F07820"/>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- keyboard focus: a neon outline -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#F07820" StrokeThickness="1.5" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True">
                        <Rectangle.Effect><DropShadowEffect Color="#F07820" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeonFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#F07820" StrokeThickness="1.5" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True">
                        <Rectangle.Effect><DropShadowEffect Color="#F07820" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: squared, thin border, glow on hover -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="Background" Value="#1E1829"/>
        <Setter Property="BorderBrush" Value="#463C58"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"/>
                        <Border x:Name="hl" Background="#F07820" Opacity="0" CornerRadius="2"/>
                        <StackPanel x:Name="sp" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ic" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconConv}}"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconVis}}"
                                  Margin="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGap}}"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.08"/><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/>
                            <Setter TargetName="b" Property="Effect"><Setter.Value><DropShadowEffect Color="#F07820" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.16"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        <Trigger Property="Tag" Value="icon"><Setter TargetName="cp" Property="Visibility" Value="Collapsed"/><Setter TargetName="ic" Property="Margin" Value="0"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CheckedBg}"/><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CheckedLine}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Btn}"/>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#47F07820" Offset="0"/><GradientStop Color="#24F07820" Offset="1"/></LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#F07820"/>
        <Setter Property="Foreground" Value="#F59A50"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="track" DockPanel.Dock="Left" Width="40" Height="20" CornerRadius="2" Background="#1E1829" BorderBrush="#4A4060" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="word" Text="OFF" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#9790A8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border x:Name="knob" Width="12" Height="12" CornerRadius="1" Background="#6E6684" HorizontalAlignment="Left" Margin="3,0,3,0"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#6ED28C"/>
                            <Setter TargetName="track" Property="Background" Value="#1B3326"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Background" Value="#6ED28C"/>
                            <Setter TargetName="word" Property="Text" Value="ON"/>
                            <Setter TargetName="word" Property="Foreground" Value="#6ED28C"/>
                            <Setter TargetName="word" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="word" Property="Margin" Value="5,0,0,0"/>
                            <Setter TargetName="knob" Property="Effect"><Setter.Value><DropShadowEffect Color="#6ED28C" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#F07820"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="CaretBrush" Value="#F07820"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="#120E18" BorderBrush="#3A3248" BorderThickness="1" CornerRadius="2" Padding="10,0" Height="32">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PasswordField" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="CaretBrush" Value="#F07820"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="#120E18" BorderBrush="#3A3248" BorderThickness="1" CornerRadius="2" Padding="10,0" Height="32">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#1C1726" BorderBrush="#463C58" BorderThickness="1" CornerRadius="2" Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1C1726" BorderBrush="#F07820" BorderThickness="1" CornerRadius="2" Padding="10,6"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="1" Background="#3A3248" Margin="3,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#6E5A96"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="#A98BE0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the page list: a neon bar on the left of the open page, the icon glows on hover -->
    <Style x:Key="Nav" TargetType="Button">
        <Setter Property="Foreground" Value="#D6D0E2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="0,1">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="#F07820" Visibility="Hidden">
                            <Rectangle.Effect><DropShadowEffect Color="#F07820" BlurRadius="10" ShadowDepth="0" Opacity="1"/></Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#221C2E"/>
                            <Setter TargetName="cp" Property="Effect"><Setter.Value><DropShadowEffect Color="#F07820" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#33F07820" Offset="0"/><GradientStop Color="#00F07820" Offset="1"/></LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#F07820"/>
        <Setter Property="Background" Value="#1E1829"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
    </Style>
</ResourceDictionary>
